# Copy to .env and fill in values. Backend loads .env from this directory when run.

# Database
DATABASE_URL=sqlite:///./jukebox.db

# Music Library
MUSIC_LIBRARY_PATH=/Volumes/SamsungT7/MusicLibrary/Albums
# Optional: Playlists folder (default: parent of MUSIC_LIBRARY_PATH + /Playlists)
# PLAYLISTS_PATH=

# Set to false for deployed/Spotify-only mode: disables library scan; playback uses Spotify only.
ENABLE_LOCAL_LIBRARY=true

# API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000
# Optional: when API is on a different host (e.g. deployed), set for OAuth redirect_uri
# API_BASE_URL=https://your-api.example.com

# Auth: change in production
SECRET_KEY=change-me-in-production

# Optional: create/upgrade first admin user (required on Render for login and collection URLs)
# ADMIN_SEED_EMAIL=your@email.com
# ADMIN_SEED_PASSWORD=your-secure-password
# ADMIN_SEED_SLUG=your-slug   # URL slug (e.g. dfranklin). If unset, derived from email (e.g. drakewilcox).

# Spotify (OAuth + admin Connect / Sync / Add by URL)
# Get credentials from https://developer.spotify.com/dashboard — add Redirect URIs in app settings.
SPOTIFY_CLIENT_ID=change-me
SPOTIFY_CLIENT_SECRET=change-me

# Frontend URL for OAuth redirect (add same URI in Spotify Dashboard)
FRONTEND_URL=http://127.0.0.1:5173
