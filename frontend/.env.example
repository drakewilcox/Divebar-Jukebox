# Optional: backend URL when not using Vite proxy (leave unset for local dev so /api is proxied to localhost:8000)
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional: default jukebox route when opening /. Use your local user slug so "/" redirects to a collection that exists.
# VITE_DEFAULT_USER_SLUG=drakewilcox
# VITE_DEFAULT_COLLECTION_SLUG=the-motivator
