# Database
DATABASE_URL=sqlite:///./jukebox.db

# Music Library
MUSIC_LIBRARY_PATH=/Volumes/SamsungT7/MusicLibrary/Albums
# Set to false for deployed/cloud mode: disables library scan; playback uses Spotify only where available
# ENABLE_LOCAL_LIBRARY=false

# API Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Backend Server
API_HOST=0.0.0.0
API_PORT=8000

# First admin user (optional): set to create or upgrade the user that owns existing collections/albums
# ADMIN_SEED_EMAIL=your@email.com
# ADMIN_SEED_PASSWORD=your-secure-password

# Spotify (for listener OAuth and admin Connect / Sync / Add by URL)
# Get credentials from https://developer.spotify.com/dashboard — create an app and add Redirect URIs.
# Backend reads .env from the backend directory: copy these into backend/.env
# SPOTIFY_CLIENT_ID=your_client_id
# SPOTIFY_CLIENT_SECRET=your_client_secret
# FRONTEND_URL=http://localhost:5173
# Optional if API is on a different host (e.g. deployed): API_BASE_URL=https://your-api.example.com
